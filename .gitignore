# ==========================================
# Data Files
# ==========================================

# Original downloaded datasets
data/raw/*

# Generated intermediate datasets
data/interim/*

# Generated processed datasets
data/processed/*

# Preserve directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

